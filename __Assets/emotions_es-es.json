    {
      "pattern": "\\b(pero\\s+ahora|y\\s+ahora|al\\s+final|finalmente|por\\s+fin)\\b",
      "type": "Giro Temporal"
    },
    {
      "pattern": "(?:\\.{3,}|…|——|--|;)\\s*",
      "type": "Pausa Dramática"
    },
    {
      "pattern": "\\?\\s*(?:¡|!)",
      "type": "Ruptura Emocional"
    }
  ],
