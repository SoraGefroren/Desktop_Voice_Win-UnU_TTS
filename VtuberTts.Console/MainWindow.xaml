<Window x:Class="VtuberTts.Console.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TTS Studio" Height="620" Width="950" 
        Background="#0f1117" Foreground="White" WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra Superior con Botón Play / Pause / Stop Dinámico -->
        <!-- Barra Superior con Botón Play / Pause / Stop y Monitor de Emoción -->
        <Grid Background="#6d28d9" Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="🎙" FontSize="20" Margin="0,0,10,0"/>
                <TextBlock Text="TTS" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="BtnPlay" Content="▶" Width="60" Height="40" Background="White" Foreground="#6d28d9" FontSize="18" FontWeight="Bold" Click="BtnPlay_Click" Cursor="Hand"/>
                
                <StackPanel x:Name="PanelPauseStop" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="BtnPause" Content="⏸" Width="60" Height="40" Background="White" Foreground="#6d28d9" FontSize="18" FontWeight="Bold" Margin="0,0,10,0" Click="BtnPause_Click" Cursor="Hand"/>
                    <Button x:Name="BtnStop" Content="⏹" Width="60" Height="40" Background="White" Foreground="#6d28d9" FontSize="18" FontWeight="Bold" Click="BtnStop_Click" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>

            <!-- Indicador de Emoción del Avatar -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                <TextBlock x:Name="LblEmotionEmoji" Text="😐" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="LblEmotionName" Text="Neutral" Foreground="#e2e8f0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Cuerpo Principal -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel Izquierdo: Controles -->
            <Border Background="#161b22" CornerRadius="8" Padding="15" Margin="0,0,15,0">
                <StackPanel>
                    <TextBlock Text="🌐 Idioma" FontWeight="SemiBold" Foreground="#cbd5e1" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CbLanguage" Height="32" Background="#21262d" Foreground="White" SelectionChanged="CbLanguage_SelectionChanged" Margin="0,0,0,15"/>

                    <TextBlock Text="🎙 Voz" FontWeight="SemiBold" Foreground="#cbd5e1" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CbVoices" Height="32" Background="#21262d" Foreground="White" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="⚡ Velocidad" FontWeight="SemiBold" Foreground="#cbd5e1" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="LblSpeed" Text="1.0x" Foreground="#38bdf8" HorizontalAlignment="Right" FontWeight="Bold"/>
                    </Grid>
                    <Slider x:Name="SliderSpeed" Minimum="0.5" Maximum="2.0" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="SliderSpeed_ValueChanged" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="🎵 Tono" FontWeight="SemiBold" Foreground="#cbd5e1" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="LblPitch" Text="1.0" Foreground="#38bdf8" HorizontalAlignment="Right" FontWeight="Bold"/>
                    </Grid>
                    <Slider x:Name="SliderPitch" Minimum="0.5" Maximum="1.5" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="SliderPitch_ValueChanged" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="🔊 Volumen" FontWeight="SemiBold" Foreground="#cbd5e1" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="LblVolume" Text="100%" Foreground="#38bdf8" HorizontalAlignment="Right" FontWeight="Bold"/>
                    </Grid>
                    <Slider x:Name="SliderVolume" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderVolume_ValueChanged" Margin="0,0,0,5"/>
                </StackPanel>
            </Border>

            <!-- Panel Derecho: Texto enriquecido con resaltado de segmentos -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="8" Padding="5">
                    <Grid>
                        <RichTextBox x:Name="RtbInput" AcceptsReturn="True" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="15" Padding="10" 
                            TextChanged="RtbInput_TextChanged" PreviewMouseLeftButtonDown="RtbInput_PreviewMouseLeftButtonDown" CaretBrush="White"/>
                        
                        <Border Background="#21262d" CornerRadius="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Padding="8,4" IsHitTestVisible="False">
                            <TextBlock x:Name="LblCharCount" Text="303 caracteres" Foreground="#94a3b8" FontSize="12"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Botones de Descarga inferiores -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button x:Name="BtnSegmentedDownload" Content="Descarga segmentada" Background="#21262d" Foreground="#94a3b8" FontWeight="SemiBold" Padding="15,10" Margin="0,0,10,0" BorderBrush="#30363d" Click="BtnSegmentedDownload_Click" Cursor="Hand"/>
                    <Button x:Name="BtnDownloadAudio" Content="📥 Descargar como Audio" Background="#7c3aed" Foreground="White" FontWeight="Bold" Padding="15,10" Click="BtnDownloadAudio_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>